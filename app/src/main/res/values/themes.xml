<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MedUMinderV1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
<!--        Background Windows Color-->
        <item name="android:windowBackground">@color/bckg</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/white</item> <!--warna utama app-->
        <item name="colorPrimaryVariant">@color/pink</item>
        <item name="colorOnPrimary">@color/black</item> <!--warna teks/icon utama app-->
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/green</item> <!--warna aksen-->
        <item name="colorSecondaryVariant">@color/green</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="android:fontFamily">@font/inter_18pt_regular</item>
        <item name="fontFamily">@font/inter_18pt_regular</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/medicine_icon</item>
    </style>

    <style name="MaterialButtonLog" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">15dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="backgroundTint">@color/hover_pressed</item>
        <item name="rippleColor">@color/hover_pressed</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>