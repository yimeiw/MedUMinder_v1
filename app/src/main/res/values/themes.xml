<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base applicatio›n theme. -->
    <style name="Theme.MedUMinderV1" parent="Theme.MaterialComponents.Light.NoActionBar">
<!--        Background Windows Color-->
        <item name="colorSurface">@color/bckg</item>
        <item name="colorOnSurface">@color/black</item> <!-- teks, hitam jadi putih -->
        <item name="colorPrimary">@color/white</item> <!--putih jadi abu tua-->
        <item name="colorSecondary">@color/white</item>  <!--white jadi biru-->
        <item name="colorTertiary">@color/biru</item> <!--biru jadi abu tengah-->
        <item name="colorAccent">@color/biru</item> <!--biru jadi putih-->
        <item name="colorOnPrimary">@color/black</item> <!--itam jadi abu tua-->
        <item name="colorPrimaryVariant">@color/black</item><!-- itam biru -->
        <item name="colorScheme">@color/abu_tua</item>
        <item name="colorBackgroundFloating">@color/white</item> <!-- putih abu tengah -->
        <item name="colorPrimaryFixed">@color/white</item>
        <item name="colorPrimaryFixedDim">@color/black</item>
        <item name="colorTertiaryFixed">@color/green</item>
        <item name="colorTertiaryFixedDim">@color/merah</item>
        <item name="colorSecondaryFixedDim">@color/biru</item>
        <item name="colorSecondaryFixed">@color/placeholder</item>
        <item name="colorPrimaryInverse">@color/placeholder</item> <!--abu jadi putih-->
        <item name="colorSurfaceContainer">@color/white</item> <!-- navbottom -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- Customize your theme here. -->
<!--        <item name="android:fontFamily">@font/inter_18pt_regular</item>-->
<!--        <item name="fontFamily">@font/inter_18pt_regular</item>-->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorPrimaryInverse</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="materialTimePickerTheme">@style/CustomMaterialTimePicker</item>

        <item name="android:fontFamily">@font/app_font</item>
        <item name="textAppearanceButton">@style/AppButtonText</item>
    </style>

    <style name="MaterialButtonLog" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingHorizontal">22dp</item>
        <item name="backgroundTint">@color/hover_pressed</item>
        <item name="rippleColor">@color/hover_pressed</item>
        <item name="android:textColor">@color/white</item>
    </style>


    <style name="CustomMaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="AppButtonText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
    </style>

</resources>