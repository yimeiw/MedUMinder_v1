        <item name="colorPrimary">@color/bckg</item> <!--warna utama app-->
        <item name="colorPrimaryVariant">@color/pink</item>
        <item name="colorOnPrimary">@color/black</item> <!--warna teks/icon utama app-->
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/green</item> <!--warna aksen-->
