<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MedUMinderV1" parent="Theme.MaterialComponents.Light.NoActionBar">
<!--        Background Windows Color-->
        <item name="colorSurface">@color/bckg</item>
        <item name="colorOnSurface">@color/black</item> <!--hitam jadi pink-->
        <item name="colorPrimary">@color/white</item> <!--putih jadi pink untuk text-->
        <item name="colorSecondary">@color/pink</item>  <!--pink jadi darkpink-->
        <item name="colorTertiary">@color/green</item> <!--hijo jadi putih-->
        <item name="colorAccent">@color/pink</item> <!--pink jadi putih-->
        <item name="colorPrimaryFixed">@color/white</item>
        <item name="colorPrimaryFixedDim">@color/black</item>
        <item name="colorPrimaryInverse">@color/placeholder</item> <!--abu jadi putih-->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- Customize your theme here. -->
        <item name="android:fontFamily">@font/inter_18pt_regular</item>
        <item name="fontFamily">@font/inter_18pt_regular</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:hint">?attr/colorPrimaryInverse</item>
    </style>

    <style name="MaterialButtonLog" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">15dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="backgroundTint">@color/hover_pressed</item>
        <item name="rippleColor">@color/hover_pressed</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="OtpItem">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:hint"> </item>
        <item name="android:background">@drawable/bg_otp</item>
    </style>
</resources>