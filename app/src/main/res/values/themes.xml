<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base applicatio›n theme. -->
    <style name="Theme.MedUMinderV1" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorSurface">@color/bckg</item>
        <item name="colorOnSurface">@color/black</item> <!-- teks, hitam jadi putih -->
        <item name="colorPrimary">@color/white</item> <!--putih jadi abu tua-->
        <item name="colorSecondary">@color/white</item>  <!--white jadi biru-->
        <item name="colorTertiary">@color/biru</item> <!--biru jadi abu tengah-->
        <item name="colorAccent">@color/biru</item> <!--biru jadi putih-->
        <item name="colorOnPrimary">@color/black</item> <!--itam jadi abu tua-->
        <item name="colorPrimaryVariant">@color/black</item><!-- itam biru -->
        <item name="colorScheme">@color/abu_tua</item>
        <item name="colorOnBackground">@color/dark_text</item>
        <item name="colorOutline">@color/black</item>
        <item name="colorBackgroundFloating">@color/white</item> <!-- putih abu tengah -->
        <item name="colorPrimaryFixed">@color/white</item>
        <item name="colorPrimaryFixedDim">@color/black</item>
        <item name="appOutline">@color/black</item>
        <item name="progressTrack">@color/progress_track</item>
        <item name="unreadAccent">@color/biru</item>
        <item name="unreadSurface">@color/notif_unread</item>
        <item name="readSurface">@android:color/transparent</item>
        <item name="readOutline">@color/gray</item>
        <item name="colorTertiaryFixed">@color/green</item>
        <item name="colorTertiaryFixedDim">@color/merah</item>
        <item name="colorSecondaryFixedDim">@color/biru</item>
        <item name="colorSecondaryFixed">@color/placeholder</item>
        <item name="colorPrimaryInverse">@color/placeholder</item> <!--abu jadi putih-->
        <item name="colorSurfaceContainer">@color/white</item> <!-- navbottom -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="pressedRipple">@color/biru</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- Customize your theme here. -->
<!--        <item name="android:fontFamily">@font/inter_18pt_regular</item>-->
<!--        <item name="fontFamily">@font/inter_18pt_regular</item>-->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorPrimaryInverse</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="materialTimePickerTheme">@style/CustomMaterialTimePicker</item>

        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="textAppearanceButton">@style/AppButtonText</item>
        <item name="textAppearanceHeadline1">@style/AppText.Headline1</item>
        <item name="textAppearanceHeadline2">@style/AppText.Headline2</item>
        <item name="textAppearanceHeadline3">@style/AppText.Headline3</item>
        <item name="textAppearanceHeadline4">@style/AppText.Headline4</item>
        <item name="textAppearanceHeadline5">@style/AppText.Headline5</item>
        <item name="textAppearanceHeadline6">@style/AppText.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/AppText.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/AppText.Subtitle2</item>
        <item name="textAppearanceBody1">@style/AppText.Body1</item>
        <item name="textAppearanceBody2">@style/AppText.Body2</item>
        <item name="textAppearanceCaption">@style/AppText.Caption</item>
        <item name="textAppearanceOverline">@style/AppText.Overline</item>
        <item name="android:textAppearance">@style/AppText.Default</item>
        <item name="android:textAppearanceSmall">@style/AppText.Small</item>
        <item name="android:textAppearanceMedium">@style/AppText.Medium</item>
        <item name="android:textAppearanceLarge">@style/AppText.Large</item>
        <item name="textAppearanceLargePopupMenu">@style/AppText.PopupMenu.Large</item>
        <item name="textAppearanceSmallPopupMenu">@style/AppText.PopupMenu.Small</item>
        <item name="android:textAppearanceLargePopupMenu">@style/AppText.PopupMenu.Large</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/AppText.PopupMenu.Small</item>
        <item name="textAppearanceListItem">@style/AppText.ListItem</item>
        <item name="textAppearanceListItemSmall">@style/AppText.ListItemSmall</item>
    </style>

    <!-- Baris info di kartu detail notifikasi (ikon diatur dari kode) -->
    <style name="NotifDetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="MaterialButtonLog" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingHorizontal">22dp</item>
        <item name="backgroundTint">@color/hover_pressed</item>
        <item name="rippleColor">@color/hover_pressed</item>
        <item name="android:textColor">@color/white</item>
    </style>


    <!-- Filter periode di Statistik: dipilih = biru, lainnya = kartu biasa -->
    <style name="MaterialButtonPeriod" parent="Widget.MaterialComponents.Button">
        <item name="android:checkable">true</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/period_button_bg</item>
        <item name="android:textColor">@color/period_button_text</item>
        <item name="strokeColor">?attr/appOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="CustomMaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="AppButtonText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
    </style>

</resources>