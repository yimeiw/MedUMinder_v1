<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ScheduleActivity"
    android:background="@color/bckg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:background="@drawable/ic_add_med"
                android:id="@+id/btnAddReminder"
                android:layout_gravity="center"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvSchedulePage"
                android:text="Schedule"
                android:fontFamily="@font/inter_24pt_bold"
                android:textSize="24sp"
                android:layout_weight="1"
                android:gravity="center"/>

            <Button
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:background="@drawable/ic_add_appoint"
                android:id="@+id/btnAddAppoint"
                android:layout_gravity="center"
                />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>