<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Login.LoginActivity"
    android:background="?attr/colorOnSurface"
    >

    <ImageView
        android:id="@+id/capsule"
        android:layout_width="match_parent"
        android:layout_height="620dp"
        android:src="@drawable/capsule_login_signup"
        android:layout_alignParentBottom="true"
        />

    <ImageView
        android:id="@+id/logo"
        android:src="@drawable/logo_tulisan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/capsule"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        />

    <TextView
        android:id="@+id/welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome! Please Login Here"
        android:textColor="?attr/colorOnSurface"
        android:layout_below="@id/logo"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/inter_18pt_medium"
        />

    <LinearLayout
        android:id="@+id/phone_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/welcome"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/inter_18pt_semibold"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            />

        <LinearLayout
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/edittext_border"
            >
            <com.hbb20.CountryCodePicker
                android:id="@+id/picker_country"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                app:ccp_defaultNameCode="ID"
                app:ccp_showFlag="false"
                app:ccp_showNameCode="false"
                app:ccp_contentColor="?attr/colorPrimaryInverse"
                app:ccp_textSize="12sp"
                />

            <EditText
                android:id="@+id/phone_input"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Input your phone number"
                android:textColorHint="?attr/colorPrimaryInverse"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:inputType="phone"
                />

        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="15dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendOtp"
            android:text="Send OTP"
            android:textColor="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/phone_section"
            android:layout_gravity="center"
            android:layout_centerHorizontal="true"
            android:background="@drawable/button_selector"
            android:fontFamily="@font/inter_18pt_medium"
            app:backgroundTint="?attr/colorSecondary"
            android:textAllCaps="false"
            />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/phone_section"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        >

        <View
            android:layout_width="84dp"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:layout_gravity="center"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Or Login with"
            android:layout_gravity="center"
            android:paddingHorizontal="20dp"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/inter_18pt_medium"
            />

        <View
            android:layout_width="84dp"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:layout_gravity="center"
            />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/auth_provider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/separator"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        >

        <ImageButton
            android:id="@+id/google_provider"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/google_default"
            android:layout_gravity="center"
            android:layout_marginEnd="20dp"
            android:focusable="true"
            />

        <ImageButton
            android:id="@+id/email"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/email"
            android:layout_gravity="center"
            android:focusable="true"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dont_have_acc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/auth_provider"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don’t have an accout yet?"
            android:fontFamily="@font/inter_18pt_medium"
            android:textColor="?attr/colorOnSurface"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_up_here"
            android:fontFamily="@font/inter_18pt_medium"
            android:textColor="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent"
            android:backgroundTint="@null"
            android:textAllCaps="false"
            />
    </LinearLayout>

</RelativeLayout>