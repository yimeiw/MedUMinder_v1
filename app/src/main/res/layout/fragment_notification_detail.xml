<?xml version="1.0" encoding="utf-8"?>
<!-- Detail notifikasi (sama untuk semua jenis notifikasi):
     1. kartu utama  : ikon + jenis, judul, waktu lengkap, isi pesan (selalu tampil)
     2. kartu detail : obat/appointment, jadwal, stok, status (id notifDetail; otomatis
                       disembunyikan kalau tidak ada baris yang terisi)
     3. tombol aksi  : tepat di bawah kartu, ikut ter-scroll -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Notification.NotificationDetailFragment">

    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:background="@drawable/ic_back"
            android:contentDescription="@string/kembali"
            app:tint="@color/hover_pressed" />

        <TextView
            android:id="@+id/tvHeaderNotif"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/detail_notifikasi_header"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- penyeimbang tombol back supaya judul benar-benar di tengah -->
        <Space
            android:layout_width="30dp"
            android:layout_height="26dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSection"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- KARTU UTAMA -->
            <LinearLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_offset"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/typeIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_notif" />

                    <TextView
                        android:id="@+id/typeChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Medicine Reminder" />
                </LinearLayout>

                <TextView
                    android:id="@+id/titleNotif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="@string/reminder_what" />

                <TextView
                    android:id="@+id/timeNotif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.7"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    tools:text="Monday, 29 Sep 2026 • 08:00" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:alpha="0.15"
                    android:background="@drawable/divider_soft" />

                <TextView
                    android:id="@+id/messageNotif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true"
                    android:textSize="15sp"
                    tools:text="@string/message_placeholder" />
            </LinearLayout>

            <!-- KARTU DETAIL -->
            <LinearLayout
                android:id="@+id/notifDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/border_hugcontent_nopadding"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="@string/detail_label"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScheduleName"
                    style="@style/NotifDetailRow"
                    tools:text="Medicine: Paracetamol" />

                <TextView
                    android:id="@+id/tvScheduleDayTime"
                    style="@style/NotifDetailRow"
                    tools:text="3x a day • 08:00, 13:00, 19:00" />

                <TextView
                    android:id="@+id/tvStockInfo"
                    style="@style/NotifDetailRow"
                    tools:text="Stock left: 12" />
            </LinearLayout>

            <!-- TOMBOL AKSI: tepat di bawah kartu -->
            <LinearLayout
                android:id="@+id/actionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/button_selector"
                    android:minHeight="52dp"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorPrimaryFixed"
                    android:textSize="15sp"
                    android:visibility="gone"
                    app:backgroundTint="@null" />

                <LinearLayout
                    android:id="@+id/layoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAcc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_selector"
                        android:minHeight="52dp"
                        android:text="@string/terima"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimaryFixed"
                        android:textSize="15sp"
                        app:backgroundTint="?attr/colorTertiaryFixed" />

                    <Space
                        android:id="@+id/spaceAccReject"
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReject"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_selector"
                        android:minHeight="52dp"
                        android:text="@string/tolak"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimaryFixed"
                        android:textSize="15sp"
                        app:backgroundTint="?attr/colorTertiaryFixedDim" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTaken"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_selector"
                        android:minHeight="52dp"
                        android:paddingHorizontal="8dp"
                        android:maxLines="1"
                        android:text="@string/sudah_diminum"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimaryFixed"
                        android:textFontWeight="600"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:backgroundTint="@null"
                        android:visibility="gone" />

                    <Space
                        android:id="@+id/spaceTakenSnooze"
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSnooze"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_border"
                        android:minHeight="52dp"
                        android:paddingHorizontal="8dp"
                        android:maxLines="1"
                        android:text="@string/tunda_pengingat"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textFontWeight="600"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:backgroundTint="@null"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
