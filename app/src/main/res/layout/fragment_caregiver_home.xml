<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Home.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--            Logo & Icon Notif-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnNotif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_sidenav"
                    android:background="@null"
                    android:layout_gravity="center"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/logo"
                        android:src="@drawable/logo_tulisan"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/capsule"
                        />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_notif"
                    android:background="@null"
                    android:layout_gravity="center"/>

            </LinearLayout>
            <!--greetings-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" "
                android:fontFamily="@font/inter_18pt_semibold"
                android:id="@+id/greeting"
                android:textSize="18sp"
                android:layout_marginTop="10dp"
                android:textColor="?attr/colorOnSurface"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/greetings_caregiver"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOnSurface"
                android:layout_gravity="center"
                android:layout_marginVertical="20dp"
                />
<!--            pilih consumer yang mau diawasi-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/border"
                android:paddingHorizontal="20dp"
                android:paddingVertical="22dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_profile"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/namaConsumer"
                    android:layout_weight="1"
                    android:textSize="14sp"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    android:layout_gravity="center"/>

            </LinearLayout>

            <!--            card jadwal skrg-->
            <LinearLayout
                android:id="@+id/card_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/edittext_border"
                android:layout_marginVertical="10dp">

                <TextView
                    android:id="@+id/tvcard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jadwal Berikutnya"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="10dp"
                    android:background="@android:color/transparent"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvtitleCard"
                    android:fontFamily="@font/inter_24pt_bold"
                    android:textSize="24sp"
                    android:text="Nama Obat/Appointment"
                    android:textColor="?attr/colorPrimary"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:background="@android:color/transparent"/>

                <!--                hari, tgl-->
                <LinearLayout
                    android:id="@+id/timeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:background="@android:color/transparent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hari ini"
                        android:textColor="?attr/colorPrimary"
                        android:gravity="center"
                        android:background="@android:color/transparent"/>

                    <View
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/circle"
                        android:layout_margin="5dp"
                        android:layout_gravity="center"
                        />

                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/ic_time"
                        android:layout_gravity="center"
                        android:backgroundTint="?attr/colorPrimary"
                        android:layout_marginRight="5dp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvTime"
                        android:text="00:00"
                        android:textColor="?attr/colorPrimary"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="10dp"
                    android:background="@android:color/transparent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvStokObat"
                        android:text="Stok Obat: "
                        android:textSize="12sp"
                        android:textColor="?attr/colorPrimary"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvTotalStok"
                        android:text="10"
                        android:textSize="12sp"
                        android:textColor="?attr/colorPrimary"
                        android:background="@android:color/transparent"/>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnKonfirmasi"
                    android:text="Sudah Dikonsumsi"
                    android:background="@drawable/border"
                    app:backgroundTint="@null"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingHorizontal="12dp"
                    android:layout_margin="10dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="5dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jadwal Hari Ini"
                    android:textSize="20dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/viewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lihat Selengkapnya"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingEnd="0dp"
                        android:textColor="?attr/colorOnSurface"
                        android:background="@android:color/transparent"
                        android:backgroundTint="@null"
                        android:textAllCaps="false"
                        />

                </LinearLayout>

            </LinearLayout>

            <!--            list jadwal-->
            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="20dp"
                android:paddingHorizontal="20dp">

            </androidx.recyclerview.widget.RecyclerView>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>