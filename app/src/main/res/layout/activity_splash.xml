<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bckg">

    <View
        android:id="@+id/circle"
        android:layout_width="450dp"
        android:layout_height="450dp"
        android:layout_centerInParent="true"
        android:alpha="0"
        android:background="@drawable/circle"/>

    <TextView
        android:id="@+id/med"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Med"
        android:textColor="@color/black"
        android:textSize="40sp"
        android:fontFamily="@font/inter_28pt_black"
        android:layout_centerInParent="true"
        android:alpha="0"/>

    <TextView
        android:id="@+id/minder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minder"
        android:textColor="@color/pink"
        android:textSize="40sp"
        android:fontFamily="@font/inter_28pt_black"
        android:layout_centerInParent="true"
        android:alpha="0"/>

    <ImageView
        android:id="@+id/letter_u"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:src="@drawable/letter_u"
        android:alpha="0"/>

    <ImageView
        android:id="@+id/medicine_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/medicine_icon"/>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone"/>

</RelativeLayout>