<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Profile.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="20dp"
        android:id="@+id/headerSection">

        <ImageButton
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:background="@drawable/ic_back"
            android:id="@+id/btnBack"
            android:layout_gravity="center"
            app:tint="@color/hover_pressed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvProfilePage"
            android:text="Profile"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            />

        <ImageButton
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:background="@drawable/ic_logout"
            android:id="@+id/btnLogout"
            android:layout_gravity="center"
            />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/scrollView"
        android:layout_below="@id/headerSection"
        android:layout_marginHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--            profile-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/border"
                android:layout_marginVertical="20dp">

                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/ic_profile"
                    android:layout_gravity="center"
                    />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="20dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/name_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" "
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/email_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" "
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/curr_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consumer"
                    android:background="@drawable/border_wp"
                    android:backgroundTint="?attr/colorTertiary"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="24dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_margin="5dp"/>

            </LinearLayout>

            <!--        shortcut statistik-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/border"
                    android:backgroundTint="?attr/colorOnSurface"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tingkat Kepatuhan"
                        android:textSize="24dp"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="90%"
                        android:textStyle="bold"
                        android:textSize="24dp"
                        android:textColor="?attr/colorTertiary"
                        android:fontFamily="@font/inter_24pt_semibold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_kepatuhan_tinggi"
                        android:textSize="14dp"
                        android:textColor="?attr/colorPrimary"/>

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/btnSeeStatistic"
                        android:text="Lihat Selengkapnya"
                        android:textStyle="bold"
                        android:background="@drawable/border"
                        android:textColor="?attr/colorOnSurface"
                        app:backgroundTint="@null"
                        android:textAllCaps="false"
                        android:layout_marginVertical="10dp"/>

                </LinearLayout>

            </LinearLayout>

            <!--        pengaturan-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengaturan"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!--                pengaturan notifikasi-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/border_wp"
                    android:layout_marginVertical="5dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_notif"
                        android:layout_marginVertical="5dp"
                        android:layout_marginHorizontal="3dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notifikasi"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:layout_gravity="center"

                        android:fontFamily="@font/inter_24pt_bold"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow"
                        android:layout_gravity="center"/>

                </LinearLayout>

                <!--                pengaturan invite caregiver-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/border_wp"
                    android:layout_marginVertical="5dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_add_people"
                        android:layout_margin="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Invite Caregiver"
                        android:layout_weight="1"
                        android:layout_gravity="center"

                        android:fontFamily="@font/inter_24pt_bold"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow"
                        android:layout_gravity="center"/>

                </LinearLayout>

                <!--                pengaturan list caregiver-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/border_wp"
                    android:layout_marginVertical="5dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_people"
                        android:layout_margin="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="List Caregiver"
                        android:layout_weight="1"
                        android:layout_gravity="center"

                        android:fontFamily="@font/inter_24pt_bold"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow"
                        android:layout_gravity="center"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/border_wp"
                    android:layout_marginVertical="5dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_activate"
                        android:layout_margin="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aktivasi Caregiver"

                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_24pt_bold"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow"
                        android:layout_gravity="center"/>

                </LinearLayout>

                <!--                pengaturan profile-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/border_wp"
                    android:layout_marginVertical="5dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_edit"
                        android:layout_margin="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Profile"
                        android:layout_weight="1"
                        android:layout_gravity="center"

                        android:fontFamily="@font/inter_24pt_bold"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow"
                        android:layout_gravity="center"/>

                </LinearLayout>

                <!--                pengaturan bahasa-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/border_wp"
                    android:layout_marginVertical="5dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_lang"
                        android:layout_margin="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bahasa"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_gravity="center"

                        android:fontFamily="@font/inter_24pt_bold"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow"
                        android:layout_gravity="center"/>

                </LinearLayout>

                <!--            change theme-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/border_wp"
                    android:layout_marginVertical="5dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_hp"
                        android:layout_margin="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tampilan"
                        android:layout_weight="1"
                        android:layout_gravity="center"

                        android:fontFamily="@font/inter_24pt_bold"/>

                    <RelativeLayout
                        android:id="@+id/themeSwitch"
                        android:layout_width="90dp"
                        android:layout_height="45dp"
                        android:background="@drawable/toogle_switch"
                        android:padding="6dp"
                        android:layout_margin="5dp">

                        <ImageView
                            android:id="@+id/iconToggle"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_sun"
                            android:scaleType="centerInside"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/border_hugcontent_nopadding"/>

                    </RelativeLayout>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>