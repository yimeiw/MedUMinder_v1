<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editMedicineFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Edit.EditMedicineFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:id="@+id/headerSection">

                <ImageButton
                    android:layout_width="30dp"
                    android:layout_height="26dp"
                    android:background="@drawable/ic_back"
                    android:id="@+id/btnBack"
                    android:layout_gravity="center"
                    app:tint="@color/hover_pressed"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvAddReminderMed"
                    android:text="@string/ubahPengingat"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginVertical="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nama_obat"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginVertical="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:textColor="?attr/colorOnSurface"/>


                <EditText
                    android:id="@+id/namaObat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border"
                    android:drawableEnd="@drawable/ic_search"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp"
                    android:hint="@string/nama_obat"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"/>>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/sectionFrekuensi"
                android:layout_marginVertical="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/frekuensi_minum_obat"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:textColor="?attr/colorOnSurface"/>

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/freqMinumObat"
                    android:hint="@string/frekuensi"
                    android:background="@drawable/border"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp"
                    android:textSize="12sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none"
                    android:textColor="?attr/colorOnSurface"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/timeReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/sectionStokObat"
                android:layout_marginVertical="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tanggal_selesai_minum_obat"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:textColor="?attr/colorOnSurface"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOnSurface"
                    app:contentPadding="16dp"
                    app:cardCornerRadius="18dp">

                    <EditText
                        android:id="@+id/endDateReminder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="dd/mm/yyyy"
                        android:paddingHorizontal="10dp"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:background="@android:color/transparent"
                        />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_cal_pick"
                        android:layout_gravity="end"/>

                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginVertical="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stockObat"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:textColor="?attr/colorOnSurface"/>

                <EditText
                    android:id="@+id/stokObat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border"
                    android:hint="Stok Obat"
                    android:inputType="number"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_selector"
                app:backgroundTint="@null"
                android:text="@string/perbarui_pengingat"
                android:textColor="?attr/colorPrimary"
                android:textAllCaps="false"
                android:layout_marginVertical="10dp"/>
        </LinearLayout>
    </ScrollView>

</FrameLayout>