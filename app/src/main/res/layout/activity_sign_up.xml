<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="?attr/colorOnSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignUp.SignUpActivity">

    <ImageView
        android:id="@+id/capsule"
        android:layout_width="match_parent"
        android:layout_height="800dp"
        android:src="@drawable/capsule_login_signup"
        android:layout_alignParentBottom="true"
        />

    <ImageView
        android:id="@+id/logo"
        android:src="@drawable/logo_tulisan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/capsule"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        />

    <TextView
        android:id="@+id/welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome! Please Login Here"
        android:textColor="?attr/colorOnSurface"
        android:layout_below="@id/logo"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/inter_18pt_medium"
        />

<!--    Name-->
    <LinearLayout
        android:id="@+id/name_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/welcome"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/inter_18pt_semibold"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            />

        <EditText
            android:id="@+id/name_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_border"
            android:hint="Enter your full name"
            android:paddingStart="20dp"
            android:textColorHint="?attr/colorPrimaryInverse"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            />

    </LinearLayout>

<!--    Email-->
    <LinearLayout
        android:id="@+id/email_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/name_section"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/inter_18pt_semibold"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            />

        <EditText
            android:id="@+id/email_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_border"
            android:hint="Enter your email"
            android:paddingStart="20dp"
            android:textColorHint="?attr/colorPrimaryInverse"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            />

    </LinearLayout>

<!--    Password-->
    <LinearLayout
        android:id="@+id/password_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/email_section"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/inter_18pt_semibold"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            />

        <EditText
            android:id="@+id/password_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_border"
            android:hint="Enter your password"
            android:paddingStart="20dp"
            android:textColorHint="?attr/colorPrimaryInverse"
            android:textColor="?attr/colorPrimary"
            android:inputType="textPassword"
            android:textSize="12sp"
            />
    </LinearLayout>

<!--    Button sign up-->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/signup_button"
        android:text="SignUp"
        android:textColor="?attr/colorPrimaryFixed"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_below="@id/password_section"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:background="@drawable/button_selector"
        android:fontFamily="@font/inter_18pt_medium"
        app:backgroundTint="?attr/colorOnSurface"
        android:textAllCaps="false"
        />

<!--    Separator-->
    <LinearLayout
        android:id="@+id/separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/signup_button"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        >

        <View
            android:layout_width="84dp"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:layout_gravity="center"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Or Sign Up with"
            android:layout_gravity="center"
            android:paddingHorizontal="20dp"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/inter_18pt_medium"
            android:textSize="12sp"
            />

        <View
            android:layout_width="84dp"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:layout_gravity="center"
            />
    </LinearLayout>

<!--    Google auth-->
    <ImageButton
        android:id="@+id/google_provider"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/google_default"
        android:layout_below="@id/separator"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:focusable="true"
        />

<!--    Dont have an account-->
    <LinearLayout
        android:id="@+id/sign_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/google_provider"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account?"
            android:fontFamily="@font/inter_18pt_medium"
            android:textColor="?attr/colorOnSurface"
            android:paddingEnd="5dp"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_here"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_here"
            android:fontFamily="@font/inter_18pt_medium"
            android:textColor="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent"
            android:backgroundTint="@null"
            android:textAllCaps="false"
            />
    </LinearLayout>



</RelativeLayout>