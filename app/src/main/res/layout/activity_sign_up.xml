<?xml version="1.0" encoding="utf-8"?>
<!-- Kapsul putih mulai 90dp dari atas sampai bawah layar + form daftar.
     Layar pendek (mis. Samsung A5/A7): jarak atas lebih kecil & form bisa di-scroll, tidak terpotong.
     Ukuran di values/dimens.xml dan values-h700dp/dimens.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="?attr/colorOnPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SignUp.SignUpActivity">

    <ScrollView
        android:id="@+id/signup_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="bottom"
            android:paddingTop="@dimen/signup_capsule_margin_top">

            <LinearLayout
                android:id="@+id/capsule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/capsule_login_signup"
                android:paddingTop="@dimen/signup_capsule_padding_top"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/logo"
                    android:src="@drawable/logo_tulisan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />


                <TextView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_signup"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_18pt_medium"
                    />

            <!--    Name-->

                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/name_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nama"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/inter_18pt_semibold"
                        android:layout_marginStart="15dp"
                        android:layout_marginBottom="5dp"
                        />

                    <EditText
                        android:id="@+id/name_input"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_edittext_border"
                        android:hint="@string/enter_full_name"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:paddingStart="20dp"
                        android:textColorHint="?attr/colorPrimaryInverse"
                        android:textColor="?attr/colorPrimaryFixed"
                        android:textSize="12sp"
                        />

                </LinearLayout>

            <!--    Email-->

                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/email_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/email"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/inter_18pt_semibold"
                        android:layout_marginStart="15dp"
                        android:layout_marginBottom="5dp"
                        />

                    <EditText
                        android:id="@+id/email_input"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_edittext_border"
                        android:hint="@string/enter_email"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:paddingStart="20dp"
                        android:textColorHint="?attr/colorPrimaryInverse"
                        android:textColor="?attr/colorPrimaryFixed"
                        android:textSize="12sp"
                        android:inputType="textEmailAddress"
                        />

                </LinearLayout>

            <!--    Password-->

                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/password_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prompt_password"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/inter_18pt_semibold"
                        android:layout_marginStart="15dp"
                        android:layout_marginBottom="5dp"
                        />

                    <EditText
                        android:id="@+id/password_input"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:paddingEnd="16dp"
                        android:background="@drawable/input_edittext_border"
                        android:hint="@string/enter_password"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:paddingStart="20dp"
                        android:textColorHint="?attr/colorPrimaryInverse"
                        android:textColor="?attr/colorPrimaryFixed"
                        android:inputType="textPassword"
                        android:textSize="12sp"
                        />
                </LinearLayout>

            <!--    Button sign up-->

                <com.google.android.material.button.MaterialButton
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/signup_button"
                    android:text="@string/sign_up"
                    android:textColor="?attr/colorPrimaryFixed"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/button_selector"
                    android:fontFamily="@font/inter_18pt_medium"
                    app:backgroundTint="?attr/colorSecondaryFixedDim"
                    android:textAllCaps="false"
                    />

            <!--    Separator-->

                <LinearLayout
                    android:id="@+id/separator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_gravity="center_horizontal"
                    >

                    <View
                        android:layout_width="84dp"
                        android:layout_height="1dp"
                        android:background="?attr/colorOnSurface"
                        android:layout_gravity="center"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/or_sign_up_with"
                        android:layout_gravity="center"
                        android:paddingHorizontal="20dp"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/inter_18pt_medium"
                        android:textSize="12sp"
                        />

                    <View
                        android:layout_width="84dp"
                        android:layout_height="1dp"
                        android:background="?attr/colorOnSurface"
                        android:layout_gravity="center"
                        />
                </LinearLayout>

            <!--    Google auth-->

                <ImageButton
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/google_provider"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/google_default"
                    android:layout_marginTop="10dp"
                    android:focusable="true"
                    />

            <!--    Dont have an account-->

                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/sign_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="15dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/already_have_account"
                        android:fontFamily="@font/inter_18pt_medium"
                        android:textColor="?attr/colorOnSurface"
                        android:paddingEnd="5dp"
                        />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/login_here"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_here"
                        android:fontFamily="@font/inter_18pt_medium"
                        android:textColor="?attr/colorOnSurface"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@android:color/transparent"
                        android:backgroundTint="@null"
                        android:textAllCaps="false"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
