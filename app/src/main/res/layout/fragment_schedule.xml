<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scheduleFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Schedule.ScheduleFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:background="@drawable/ic_add_med"
                android:id="@+id/btnAddReminder"
                android:layout_gravity="center"
                android:backgroundTint="@color/hover_pressed"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvSchedulePage"
                android:text="Schedule"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:layout_weight="1"
                android:gravity="center"/>

            <ImageButton
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:background="@drawable/ic_add_appoint"
                android:id="@+id/btnAddAppoint"
                android:layout_gravity="center"
                android:backgroundTint="@color/hover_pressed"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:background="@drawable/border">

            <CalendarView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Medicine"
                android:id="@+id/btnMedicine"
                android:backgroundTint="?attr/colorPrimary"
                app:strokeWidth="1dp"
                app:cornerRadius="15dp"
                android:textAllCaps="false"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Appointment"
                android:id="@+id/btnAppointment"
                android:backgroundTint="?attr/colorPrimary"
                app:strokeWidth="1dp"
                app:cornerRadius="15dp"
                android:textAllCaps="false"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

        </androidx.recyclerview.widget.RecyclerView>

    </LinearLayout>

</RelativeLayout>