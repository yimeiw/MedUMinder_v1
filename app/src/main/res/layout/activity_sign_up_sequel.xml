<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/secondary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignUp.SignUpSequelActivity">


    <ImageView
        android:id="@+id/capsule"
        android:layout_width="match_parent"
        android:layout_height="640dp"
        android:src="@drawable/capsule_login_signup"
        android:layout_alignParentBottom="true"
        />

    <ImageView
        android:id="@+id/logo"
        android:src="@drawable/logo_tulisan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/capsule"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="130dp"
        />

    <TextView
        android:id="@+id/welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please complete your Sign Up here!"
        android:textColor="@color/secondary"
        android:layout_below="@id/logo"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/inter_18pt_medium"
        />

    <!--    Phone-->
    <LinearLayout
        android:id="@+id/phone_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/welcome"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textColor="@color/secondary"
            android:fontFamily="@font/inter_18pt_regular"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/shape_form"
            >
            <com.hbb20.CountryCodePicker
                android:id="@+id/picker_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ccp_defaultNameCode="ID"
                app:ccp_showFlag="false"
                app:ccp_showNameCode="false"
                app:ccp_contentColor="@color/white"
                app:ccp_textSize="15sp"
                android:paddingStart="10dp"
                />

            <EditText
                android:id="@+id/phone_input"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Input your phone number"
                android:textColorHint="@color/tertiary"
                android:textColor="@color/white"
                android:textSize="12sp"
                />

        </LinearLayout>

    </LinearLayout>

    <!--    Role-->
    <LinearLayout
        android:id="@+id/role_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/phone_section"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Role"
            android:textColor="@color/secondary"
            android:fontFamily="@font/inter_18pt_regular"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            />

        <AutoCompleteTextView
            android:id="@+id/role_input"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_form"
            android:inputType="none"
            android:hint="Select your role"
            android:textColorHint="@color/tertiary"
            android:textColor="@color/white"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:dropDownSelector="@android:color/transparent"
            android:popupBackground="@drawable/shape_form"/>

    </LinearLayout>

    <!--    Button sign up-->
    <Button
        android:id="@+id/sign_up_final_button"
        android:text="Sign Up"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_below="@id/role_section"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_selector"
        android:backgroundTint="@null"
        />

    <!--    Separator-->
    <LinearLayout
        android:id="@+id/separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/sign_up_final_button"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        >

        <View
            android:layout_width="84dp"
            android:layout_height="1dp"
            android:background="@color/secondary"
            android:layout_gravity="center"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Or Sign Up with"
            android:layout_gravity="center"
            android:paddingHorizontal="20dp"
            android:textColor="@color/secondary"
            android:fontFamily="@font/inter_18pt_medium"
            android:textSize="12sp"
            />

        <View
            android:layout_width="84dp"
            android:layout_height="1dp"
            android:background="@color/secondary"
            android:layout_gravity="center"
            />
    </LinearLayout>

    <!--    Google auth-->
    <Button
        android:id="@+id/google_provider"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/google_selector"
        android:layout_below="@id/separator"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:focusable="true"
        />

    <!--    Dont have an account-->
    <LinearLayout
        android:id="@+id/sign_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/google_provider"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don’t have an accout yet?"
            android:fontFamily="@font/inter_18pt_medium"
            android:textColor="@color/secondary"
            android:paddingEnd="5dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_up_here"
            android:fontFamily="@font/inter_18pt_medium"
            android:textColor="@color/text_selector"
            android:clickable="true"
            android:focusable="true"
            />
    </LinearLayout>



</RelativeLayout>