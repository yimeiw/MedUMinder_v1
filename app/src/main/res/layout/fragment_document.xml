<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/documentFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HealthDocument.DocumentFragment"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="20dp"
        android:id="@+id/headerSection">

        <ImageButton
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:background="@drawable/ic_back"
            android:id="@+id/btnBack"
            android:layout_gravity="center"
            app:tint="@color/hover_pressed"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dokumen Kesehatan"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/black"/>
    </LinearLayout>

<!--    belum ada dokumen -->
    <LinearLayout
        android:id="@+id/nullStateDocument"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum ada file."
            android:textSize="20sp"
            android:layout_marginBottom="20dp"
            />

        <LinearLayout
            android:id="@+id/addDocumentNullState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:background="@drawable/border_hugcontent_nopadding"
            android:paddingVertical="15dp"
            android:paddingHorizontal="100dp"
            >
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_add"
                android:paddingEnd="10dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tambah file"
                android:textSize="20sp"
                />
        </LinearLayout>
    </LinearLayout>

<!--    ada dokumen-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/border_hugcontent_nopadding"
        android:layout_margin="30dp"
        android:gravity="center_horizontal"
        >

        <ImageView
            android:id="@+id/previewDoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="50dp"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/black"
            />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical"
            >
            <TextView
                android:id="@+id/nameDoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doc 1"
                android:textSize="16sp"
                android:paddingEnd="10dp"
                />

            <ImageButton
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:background="@drawable/ic_more"
                android:id="@+id/btnOptionDoc"
                android:layout_gravity="center"
                app:tint="@color/hover_pressed"
                />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>