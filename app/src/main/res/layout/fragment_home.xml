<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Home.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        android:paddingHorizontal="20dp"
        android:scrollIndicators="none"
        android:scrollbars="none"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--            Logo & Icon Notif-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logo"
                    android:src="@drawable/logo_tulisan"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical">

                    <!-- lonceng + angka notif -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageButton
                            android:id="@+id/btnNotif"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_notif_hover"
                            android:background="@null"
                            android:padding="6dp"/>

                        <!-- angka notif belum dibaca -->
                        <TextView
                            android:id="@+id/tvNotifBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:minWidth="20dp"
                            android:layout_gravity="top|end"
                            android:gravity="center"
                            android:paddingHorizontal="5dp"
                            android:background="@drawable/bg_badge"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"/>
                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>
            <!--greetings-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" "
                android:fontFamily="@font/inter_18pt_semibold"
                android:id="@+id/greeting"
                android:textSize="18sp"
                android:layout_marginTop="10dp"
                android:textColor="?attr/colorOnSurface"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/greetings_consumer"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOnSurface"
                android:layout_gravity="center"
                android:layout_marginVertical="20dp"
                />

            <!--            shortcut-->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal"
                android:layout_gravity="fill_horizontal">

                <LinearLayout
                    android:id="@+id/layoutAddMed"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/border">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_add_med"
                        android:background="@android:color/transparent"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/tambah_pengingat"
                        android:textAlignment="center"
                        android:fontFamily="@font/inter_18pt_semibold"
                        android:textColor="?attr/colorOnSurface"
                        android:background="@android:color/transparent"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutAddAppoint"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/border">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_add_appoint"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_18pt_semibold"
                        android:text="@string/tambah_appointment"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnSurface"
                        android:background="@android:color/transparent"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutLog"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/border"
                    android:clickable="true">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_log"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/log_jadwal"
                        android:textAlignment="center"
                        android:fontFamily="@font/inter_18pt_semibold"
                        android:textColor="?attr/colorOnSurface"
                        android:background="@android:color/transparent"/>

                </LinearLayout>
            </GridLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOnSurface"
                android:layout_gravity="center"
                android:layout_marginVertical="20dp"
                />

            <!--            card jadwal berikutnya-->
            <LinearLayout
                android:id="@+id/card_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/edittext_border"
                android:layout_margin="8dp">

                <TextView
                    android:id="@+id/tvcard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/jadwal_berikutnya"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:textColor="?attr/colorPrimaryFixed"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="10dp"/>

                <!--                ada jadwal-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/haveSchedule"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvtitleCard"
                        android:fontFamily="@font/inter_24pt_bold"
                        android:textSize="24sp"
                        android:text=""
                        android:textColor="?attr/colorPrimaryFixed"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"/>

                    <!--                hari, tgl-->
                    <LinearLayout
                        android:id="@+id/timeCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tvDay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="?attr/colorPrimaryFixed"
                            android:gravity="center"/>

                        <View
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:background="@drawable/circle"
                            android:backgroundTint="?attr/colorPrimaryFixed"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/ic_time"
                            android:layout_gravity="center"
                            android:backgroundTint="?attr/colorPrimaryFixed"
                            android:layout_marginRight="5dp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tvTime"
                            android:text="00:00"
                            android:textColor="?attr/colorPrimaryFixed"
                            android:layout_gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tvStokObat"
                            android:text="@string/stok_obat"
                            android:textSize="12sp"
                            android:textColor="?attr/colorPrimaryFixed"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tvTotalStok"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="?attr/colorPrimaryFixed"/>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/btnKonfirmasi"
                        android:text="@string/sudah_dikonsumsi"
                        android:background="@drawable/border_wp"
                        app:backgroundTint="@null"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:paddingHorizontal="12dp"
                        android:layout_margin="10dp"/>
                </LinearLayout>

                <!--                belum ada jadwal-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/noSchedule"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/belum_ada_jadwal"
                        android:textSize="14sp"
                        android:textColor="?attr/colorPrimaryFixed"
                        android:layout_marginBottom="20dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/addNoSchedule"
                        android:text="@string/tambahkan_jadwal"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSurface"
                        android:background="@drawable/border_wp"
                        android:layout_marginHorizontal="12dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconTint="@null"
                        app:iconPadding="12dp"/>
                </LinearLayout>

            </LinearLayout>

            <!--            jadwal hari ini-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/todaySched"
                android:layout_marginVertical="10dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="5dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jadwal_hari_ini"
                        android:textSize="20dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/viewAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lihat_selengkapnya"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingEnd="0dp"
                            android:textColor="?attr/colorOnSurface"
                            android:background="@android:color/transparent"
                            android:backgroundTint="@null"
                            android:textAllCaps="false"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                </LinearLayout>
                <!--            list jadwal-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTodaySchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"
                    android:layout_marginHorizontal="10dp"
                    android:visibility="gone"/>

                <!--            gada jadwal-->
                <TextView
                    android:id="@+id/emptyTodaySchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/tidak_ada_jadwal_hari_ini"
                    android:gravity="center"
                    android:visibility="visible"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOnSurface"
                android:layout_gravity="center"
                android:layout_marginVertical="20dp"
                />
            <!--        ringkasan statistik-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ringkasan_statistik"
                    android:textSize="20dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"/>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="@drawable/bg_nostoke"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>