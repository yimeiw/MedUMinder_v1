<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Login.LoginActivity"
    android:background="@color/secondary"
    >

    <ImageView
        android:id="@+id/capsule"
        android:layout_width="match_parent"
        android:layout_height="620dp"
        android:src="@drawable/capsule_login_signup"
        android:layout_alignParentBottom="true"
        />

    <ImageView
        android:id="@+id/logo"
        android:src="@drawable/logo_tulisan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/capsule"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        />

    <TextView
        android:id="@+id/welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome! Please Login Here"
        android:textColor="@color/secondary"
        android:layout_below="@id/logo"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/inter_18pt_medium"
        />

    <LinearLayout
        android:id="@+id/email_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/welcome"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="@color/secondary"
            android:fontFamily="@font/inter_18pt_regular"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            />

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_form"
            android:hint="Enter your email"
            android:paddingStart="15dp"
            android:textColorHint="@color/tertiary"
            android:textColor="@color/white"
            />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/password_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/email_section"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="@color/secondary"
            android:fontFamily="@font/inter_18pt_regular"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            />

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_form"
            android:hint="Enter your password"
            android:paddingStart="15dp"
            android:textColorHint="@color/tertiary"
            android:textColor="@color/white"
            />
    </LinearLayout>

    <Button
        android:id="@+id/login_button"
        android:text="Login"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_below="@id/password_section"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_selector"
        android:backgroundTint="@null"
        />

    <LinearLayout
        android:id="@+id/separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/login_button"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        >

        <View
            android:layout_width="84dp"
            android:layout_height="1dp"
            android:background="@color/secondary"
            android:layout_gravity="center"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Or Login with"
            android:layout_gravity="center"
            android:paddingHorizontal="20dp"
            android:textColor="@color/secondary"
            android:fontFamily="@font/inter_18pt_medium"
            />

        <View
            android:layout_width="84dp"
            android:layout_height="1dp"
            android:background="@color/secondary"
            android:layout_gravity="center"
            />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/auth_provider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/separator"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        >

        <Button
            android:id="@+id/google_provider"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/google_selector"
            android:layout_gravity="center"
            android:layout_marginEnd="20dp"
            android:focusable="true"
            />

        <Button
            android:id="@+id/phone_provider"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/phone_selector"
            android:layout_gravity="center"
            android:focusable="true"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sign_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/auth_provider"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don’t have an accout yet?"
        android:fontFamily="@font/inter_18pt_medium"
        android:textColor="@color/secondary"
        android:paddingEnd="5dp"
        />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_up_here"
            android:fontFamily="@font/inter_18pt_medium"
            android:textColor="@color/text_selector"
            android:clickable="true"
            android:focusable="true"
            />
    </LinearLayout>

</RelativeLayout>