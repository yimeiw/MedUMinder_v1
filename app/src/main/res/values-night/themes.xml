<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MedUMinderV1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorSurface">@color/dark_bckg</item>
        <item name="colorOnSurface">@color/pink</item> <!--pink jadi hitam-->
        <item name="colorPrimary">@color/black</item> <!--hitam jadi putih-->
        <item name="colorSecondary">@color/black</item> <!--putih jadi pink-->
        <item name="colorTertiary">@color/white</item>
        <item name="colorAccent">@color/white</item> <!--putih jadi pink-->
        <item name="colorPrimaryFixed">@color/black</item>
        <item name="colorPrimaryFixedDim">@color/black</item>
        <item name="colorPrimaryInverse">@color/white</item> <!--putih jadi abu-->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorOnSurface</item>
        <!-- Customize your theme here. -->
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorPrimaryInverse</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="materialTimePickerTheme">@style/CustomMaterialTimePicker</item>
    </style>

    <style name="MaterialButtonLog" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">15dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="backgroundTint">@color/hover_pressed</item>
        <item name="rippleColor">@color/hover_pressed</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="OtpItem">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:hint"> </item>
        <item name="android:background">@drawable/bg_otp</item>
    </style>

    <style name="CustomMaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

</resources>