<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MedUMinderV1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorSurface">@color/dark_bckg</item>
        <item name="colorOnSurface">@color/white</item> <!-- teks -->
        <item name="colorPrimary">@color/abu_tua</item> <!--abu tua jadi putih-->
        <item name="colorSecondary">@color/biru</item> <!--biru jadi putih-->
        <item name="colorTertiary">@color/abu_muda</item> <!--abu muda jadi biru-->
        <item name="colorAccent">@color/white</item> <!--putih jadi biru-->
        <item name="colorOnPrimary">@color/abu_tua</item> <!--abu tua jadi itam-->
        <item name="colorPrimaryVariant">@color/biru</item><!-- biru itam -->
        <item name="colorScheme">@color/abu_tengah</item>
        <item name="colorBackgroundFloating">@color/abu_tengah</item> <!-- abu tengah putih -->
        <item name="colorPrimaryFixed">@color/white</item>
        <item name="colorPrimaryFixedDim">@color/black</item>
        <item name="colorTertiaryFixed">@color/green</item>
        <item name="colorTertiaryFixedDim">@color/merah</item>
        <item name="colorSecondaryFixedDim">@color/biru</item>
        <item name="colorSecondaryFixed">@color/placeholder</item>
        <item name="colorPrimaryInverse">@color/white</item> <!--putih jadi abu-->
        <item name="colorSurfaceContainer">@color/abu_tua</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorOnSurface</item>
        <!-- Customize your theme here. -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorPrimaryInverse</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="materialTimePickerTheme">@style/CustomMaterialTimePicker</item>

        <item name="android:fontFamily">@font/app_font</item>
        <item name="textAppearanceButton">@style/AppButtonText</item>
    </style>

    <style name="MaterialButtonLog" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingHorizontal">30dp</item>
        <item name="backgroundTint">@color/hover_pressed</item>
        <item name="rippleColor">@color/hover_pressed</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomMaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="AppButtonText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
    </style>
</resources>