<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MedUMinderV1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorSurface">@color/dark_bckg</item>
        <item name="colorOnSurface">@color/dark_text</item> <!-- teks -->
        <item name="colorPrimary">@color/abu_tua</item> <!--abu tua jadi putih-->
        <item name="colorSecondary">@color/dark_blue</item> <!--biru jadi putih-->
        <item name="colorTertiary">@color/abu_muda</item> <!--abu muda jadi biru-->
        <item name="colorAccent">@color/dark_text</item> <!--putih jadi biru-->
        <item name="colorOnPrimary">@color/abu_tengah</item> <!--abu tua jadi itam-->
        <item name="colorPrimaryVariant">@color/dark_blue</item><!-- biru itam -->
        <item name="colorScheme">@color/abu_tengah</item>
        <item name="colorOnBackground">@color/abu_muda</item>
        <item name="colorOutline">@color/abu_tengah</item>
        <item name="colorBackgroundFloating">@color/abu_tengah</item> <!-- abu tengah putih -->
        <item name="colorPrimaryFixed">@color/dark_teks</item>
        <item name="colorPrimaryFixedDim">@color/abu_tengah</item>
        <item name="appOutline">@color/dark_outline</item>
        <item name="progressTrack">@color/dark_outline</item>
        <item name="unreadAccent">@color/dark_biru</item>
        <item name="unreadSurface">@color/notif_unread_dark</item>
        <item name="readSurface">@android:color/transparent</item>
        <item name="readOutline">@color/dark_outline</item>
        <item name="colorTertiaryFixed">@color/green</item>
        <item name="colorTertiaryFixedDim">@color/dark_merah</item>
        <item name="colorSecondaryFixedDim">@color/dark_biru</item>

        <!-- <item name="colorPrimaryFixed">@color/dark_text</item>
        <item name="colorPrimaryFixedDim">@color/black</item>
        <item name="colorTertiaryFixed">@color/dark_green</item>
        <item name="colorTertiaryFixedDim">@color/dark_red</item>
        <item name="colorSecondaryFixedDim">@color/dark_blue</item> -->
        
        <item name="colorSecondaryFixed">@color/placeholder</item>
        <item name="colorPrimaryInverse">@color/dark_hint</item> <!--putih jadi abu-->
        <item name="colorSurfaceContainer">@color/abu_tua</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="pressedRipple">@color/dark_blue</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Customize your theme here. -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorPrimaryInverse</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="materialTimePickerTheme">@style/CustomMaterialTimePicker</item>

        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="textAppearanceButton">@style/AppButtonText</item>
        <item name="textAppearanceHeadline1">@style/AppText.Headline1</item>
        <item name="textAppearanceHeadline2">@style/AppText.Headline2</item>
        <item name="textAppearanceHeadline3">@style/AppText.Headline3</item>
        <item name="textAppearanceHeadline4">@style/AppText.Headline4</item>
        <item name="textAppearanceHeadline5">@style/AppText.Headline5</item>
        <item name="textAppearanceHeadline6">@style/AppText.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/AppText.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/AppText.Subtitle2</item>
        <item name="textAppearanceBody1">@style/AppText.Body1</item>
        <item name="textAppearanceBody2">@style/AppText.Body2</item>
        <item name="textAppearanceCaption">@style/AppText.Caption</item>
        <item name="textAppearanceOverline">@style/AppText.Overline</item>
        <item name="android:textAppearance">@style/AppText.Default</item>
        <item name="android:textAppearanceSmall">@style/AppText.Small</item>
        <item name="android:textAppearanceMedium">@style/AppText.Medium</item>
        <item name="android:textAppearanceLarge">@style/AppText.Large</item>
        <item name="textAppearanceLargePopupMenu">@style/AppText.PopupMenu.Large</item>
        <item name="textAppearanceSmallPopupMenu">@style/AppText.PopupMenu.Small</item>
        <item name="android:textAppearanceLargePopupMenu">@style/AppText.PopupMenu.Large</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/AppText.PopupMenu.Small</item>
        <item name="textAppearanceListItem">@style/AppText.ListItem</item>
        <item name="textAppearanceListItemSmall">@style/AppText.ListItemSmall</item>
    </style>

    <style name="MaterialButtonLog" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingHorizontal">30dp</item>
        <item name="backgroundTint">@color/hover_pressed</item>
        <item name="rippleColor">@color/hover_pressed</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomMaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="AppButtonText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
    </style>
</resources>