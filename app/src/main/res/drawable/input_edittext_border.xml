<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/colorOnPrimary"/>
            <size android:width="250dp" android:height="50dp"/>
            <corners android:radius="20dp"/>
            <padding android:left="12dp" android:right="12dp" android:top="8dp" android:bottom="8dp"/>
            <stroke android:color="?attr/colorSecondaryFixedDim" android:width="2dp"/>
        </shape>
    </item>
    <item android:drawable="@drawable/edittext_border"/>
</selector>
