{
  "name": "meduminder-firestore-tools",
  "private": true,
  "description": "Admin scripts for the medicine catalog. scan/backup are read-only; migrate/delete are dry-run by default.",
  "scripts": {
    "scan": "node scan-catalog.js",
    "backup": "node backup.js",
    "migrate": "node migrate-private-medicines.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-meduminder-rules \"node --test rules.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1"
  }
}
