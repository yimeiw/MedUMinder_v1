rules_version = '2';

// STAGE A rules (private medicines). Not published yet: publish only after the backup is confirmed.
// - Every existing collection keeps EXACTLY today's access (any signed-in user), so nothing breaks.
//   Stage B (separate task) will lock those down per person.
// - New: official catalog read-only, private medicines only for the owner + their caregivers.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // caregiver of {uid}: a care_links/{uid}_{me} document exists
    function isCaregiverOf(uid) {
      return signedIn()
          && exists(/databases/$(database)/documents/care_links/$(uid + '_' + request.auth.uid));
    }

    function isOwnerOrCaregiver(uid) {
      return signedIn() && (request.auth.uid == uid || isCaregiverOf(uid));
    }

    // ---------- same access as today (Stage B will tighten these) ----------
    match /users/{uid} {
      allow read, write: if signedIn();

      // private medicines: only the person who takes them and their caregivers
      match /customMedicines/{medId} {
        allow read, delete: if isOwnerOrCaregiver(uid);
        allow create, update: if isOwnerOrCaregiver(uid)
            && request.resource.data.keys().hasOnly(
                 ['name', 'name_key', 'created_at', 'created_by', 'migrated_from_catalog_id'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 200
            && request.resource.data.name_key is string;
      }
    }
    match /medications/{id}          { allow read, write: if signedIn(); }
    match /medication_schedules/{id} { allow read, write: if signedIn(); }
    match /medication_logs/{id}      { allow read, write: if signedIn(); }
    match /appointments/{id}         { allow read, write: if signedIn(); }
    match /notifications/{id}        { allow read, write: if signedIn(); }
    match /invitations/{id}          { allow read, write: if signedIn(); }
    match /care_relationships/{id}   { allow read, write: if signedIn(); }

    // only used by older app builds; kept as today so they do not break
    match /medicine/{id}             { allow read, write: if signedIn(); }
    match /medication_catalog/{id}   { allow read, write: if signedIn(); }

    // ---------- official catalog: read-only ----------
    match /medicine_catalog/{id} {
      allow read: if signedIn();
      // TRANSITION ONLY: older app versions still add new names here.
      // Delete this "allow create" after min_version_code is set and old versions are gone.
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['nama_obat', 'created_at'])
          && request.resource.data.nama_obat is string
          && request.resource.data.nama_obat.size() > 0
          && request.resource.data.nama_obat.size() <= 200;
      allow update, delete: if false;
    }

    // ---------- caregiver links (id = consumerUid_caregiverUid) ----------
    match /care_links/{linkId} {
      allow read, delete: if signedIn()
          && (resource.data.consumer_uid == request.auth.uid
              || resource.data.caregiver_uid == request.auth.uid);
      allow create, update: if signedIn()
          && (request.resource.data.consumer_uid == request.auth.uid
              || request.resource.data.caregiver_uid == request.auth.uid)
          && linkId == request.resource.data.consumer_uid + '_' + request.resource.data.caregiver_uid
          && request.resource.data.keys().hasOnly(['consumer_uid', 'caregiver_uid', 'created_at', 'migrated']);
    }

    // ---------- "Update required": anyone can read, only you (Console) can change ----------
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- email lookup before login (same as today) ----------
    match /user_emails/{email} {
      allow read: if true;
      // Today any signed-in user can write here (the old catch-all rule allowed it).
      // Kept the same in Stage A; Stage B limits it to the owner of the email.
      allow write: if signedIn();
    }
  }
}
